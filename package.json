{
  "name": "ppt-205",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "validate": "node scripts/validate-site.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "deck:new": "node scripts/new-deck.mjs",
    "deck:list": "node scripts/manage-decks.mjs list",
    "deck:publish": "node scripts/manage-decks.mjs publish",
    "deck:draft": "node scripts/manage-decks.mjs draft",
    "qa": "node scripts/qa-slides.mjs",
    "pdf": "node scripts/export-pdfs.mjs",
    "build": "npm run validate && npm run pdf && node scripts/build-site.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "entry:build": "node Ease/source/entry/build-ease-files.mjs",
    "entry:verify": "node Ease/source/entry/verify-ease-lab.mjs",
    "entry:blocks": "node Ease/source/entry/export-block-images.mjs"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "1.59.1"
  }
}
